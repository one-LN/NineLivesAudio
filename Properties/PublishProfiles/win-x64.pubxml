<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile used by installer.iss (MyAppSourceDir = binpublish).

  dotnet publish -p:PublishProfile=win-x64 -c Release

  Unpackaged WinUI 3 app: the Windows App SDK runtime is carried in the output
  folder (WindowsAppSDKSelfContained) so the installer never needs a bootstrapper.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>binpublish\</PublishDir>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
