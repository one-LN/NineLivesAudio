<Page
    x:Class="NineLivesAudio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:NineLivesAudio.Helpers"
    xmlns:models="using:NineLivesAudio.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Background="{ThemeResource VoidDeepBrush}">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="600">

            <!-- Server Connection -->
            <StackPanel>
                <TextBlock x:Name="ServerConnectionTitle" Text="Server Connection"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <!-- Connection Status -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="12" Height="12"
                                     Fill="{x:Bind ConnectionStatusColor, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Remembered servers -->
                        <StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SavedServerBox" Grid.Column="0" Header="Saved servers"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.SavedServers}"
                                          SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:SavedServer">
                                            <TextBlock Text="{x:Bind DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="DeleteServerButton" Grid.Column="1" Content="Delete"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.DeleteSelectedServerCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasSelectedServer, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ServerSwitchStatus, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource RitualSuccessBrush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ServerSwitchStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Server Name (optional) -->
                        <TextBox x:Name="ServerNameBox" Header="Server name (optional)"
                                 PlaceholderText="e.g. Home NAS"
                                 Text="{x:Bind ViewModel.ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{x:Bind ViewModel.ServerNameStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}" Margin="0,-4,0,0"
                                   Visibility="{x:Bind ViewModel.ServerNameStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Server URL -->
                        <TextBox x:Name="ServerUrlBox" Header="Server URL"
                                 PlaceholderText="https://audiobooks.example.com"
                                 Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditServerFields, Mode=OneWay}"/>

                        <!-- Username -->
                        <TextBlock Text="{x:Bind ViewModel.ServerUrlStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}" Margin="0,-4,0,0"
                                   Visibility="{x:Bind ViewModel.ServerUrlStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <TextBox x:Name="UsernameBox" Header="Username"
                                 loc:Loc.Placeholder="EnterUsername" PlaceholderText="Enter your username"
                                 Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditServerFields, Mode=OneWay}"/>

                        <TextBlock Text="{x:Bind ViewModel.UsernameStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}" Margin="0,-4,0,0"
                                   Visibility="{x:Bind ViewModel.UsernameStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Password -->
                        <PasswordBox x:Name="PasswordBox" Header="Password"
                                     loc:Loc.Placeholder="EnterPassword" PlaceholderText="Enter your password"
                                     Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                     Visibility="{x:Bind ViewModel.CanEditServerFields, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Connect/Disconnect Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConnectButton" Content="Connect"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Background="{ThemeResource SigilGoldBrush}"
                                    Foreground="{ThemeResource VoidDeepBrush}"
                                    Command="{x:Bind ViewModel.ConnectCommand}"
                                    Visibility="{x:Bind ViewModel.CanEditServerFields, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsEnabled="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"/>

                            <Button x:Name="CancelAddServerButton" Content="Cancel"
                                    Command="{x:Bind ViewModel.CancelAddServerCommand}"
                                    Visibility="{x:Bind ViewModel.IsAddingServer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button x:Name="DisconnectButton" Content="Disconnect"
                                    Command="{x:Bind ViewModel.DisconnectCommand}"
                                    Visibility="{x:Bind ViewModel.ShowConnectedActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button x:Name="TestConnectionButton" Content="Test Connection"
                                    Command="{x:Bind ViewModel.TestConnectionCommand}"
                                    Visibility="{x:Bind ViewModel.ShowConnectedActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button x:Name="AddServerButton" Content="Add Server"
                                    Command="{x:Bind ViewModel.StartAddServerCommand}"
                                    Visibility="{x:Bind ViewModel.ShowConnectedActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Width="24"
                                          Height="24"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Playback Settings -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="PlaybackTitle" Text="Playback"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <!-- Default Volume -->
                        <StackPanel>
                            <TextBlock x:Name="DefaultVolumeLabel" Text="Default Volume" Margin="0,0,0,8"/>
                            <Slider Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.05"
                                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.VolumeStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.VolumeStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Default Playback Speed -->
                        <ComboBox x:Name="DefaultSpeedBox" Header="Default Playback Speed"
                                  SelectedIndex="{x:Bind ViewModel.SpeedSelectedIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1.0x (Normal)" Tag="1.0"/>
                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            <ComboBoxItem Content="1.75x" Tag="1.75"/>
                            <ComboBoxItem Content="2.0x" Tag="2.0"/>
                        </ComboBox>
                        <TextBlock Text="{x:Bind ViewModel.PlaybackSpeedStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.PlaybackSpeedStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Skip intro / skip outro (global, applied to every book) -->
                        <StackPanel>
                            <NumberBox x:Name="SkipIntroBox"
                                       Header="Skip intro"
                                       Minimum="0"
                                       Maximum="600"
                                       SmallChange="15"
                                       LargeChange="30"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.SkipIntroSeconds, Mode=TwoWay}"/>
                            <TextBlock x:Name="SkipIntroHint"
                                       Text="Seconds skipped automatically when a book starts playing. Saved immediately — no need to press Save (0 = off)."
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.SkipIntroStatus, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource RitualSuccessBrush}"
                                       Visibility="{x:Bind ViewModel.SkipIntroStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel>
                            <NumberBox x:Name="SkipOutroBox"
                                       Header="Skip outro"
                                       Minimum="0"
                                       Maximum="600"
                                       SmallChange="15"
                                       LargeChange="30"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.SkipOutroSeconds, Mode=TwoWay}"/>
                            <TextBlock x:Name="SkipOutroHint"
                                       Text="When fewer than this many seconds remain, continue with the next chapter; on the last chapter the book is marked finished. Saved immediately (0 = off)."
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.SkipOutroStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.SkipOutroStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Progress display mode (same switch as the player's chapter toggle) -->
                        <StackPanel>
                            <ToggleSwitch x:Name="ChapterModeSwitch" Header="Progress display: follow the chapter"
                                          IsOn="{x:Bind ViewModel.PlayerChapterMode, Mode=TwoWay}"/>
                            <TextBlock x:Name="ChapterModeHint" Text="On: the slider and times follow the current chapter. Off: they follow the whole book."
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.ChapterModeStatus, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource RitualSuccessBrush}"
                                       Visibility="{x:Bind ViewModel.ChapterModeStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Downloads Settings -->
            <StackPanel>
                <TextBlock x:Name="DownloadsTitle" Text="Downloads"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <!-- Download Path -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadLocationBox" Header="Download Location"
                                     Text="{x:Bind ViewModel.DownloadPath, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     Grid.Column="0"/>
                            <Button x:Name="BrowseButton" Content="Browse"
                                    Click="BrowseButton_Click"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,0,0"
                                    Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.DownloadPathStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.DownloadPathStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Auto Download Covers -->
                        <ToggleSwitch x:Name="AutoDownloadCoversSwitch" Header="Auto-download cover art"
                                      IsOn="{x:Bind ViewModel.AutoDownloadCovers, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.AutoDownloadCoversStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.AutoDownloadCoversStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sync Settings -->
            <StackPanel>
                <TextBlock x:Name="SyncTitle" Text="Sync"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <!-- Auto Sync Progress -->
                        <ToggleSwitch x:Name="AutoSyncSwitch" Header="Auto-sync playback progress"
                                      IsOn="{x:Bind ViewModel.AutoSyncProgress, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.AutoSyncStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.AutoSyncStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Sync Interval -->
                        <ComboBox x:Name="SyncIntervalBox" Header="Sync Interval"
                                  IsEnabled="{x:Bind ViewModel.AutoSyncProgress, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SyncIntervalSelectedIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="1 minute" Tag="1"/>
                            <ComboBoxItem Content="5 minutes" Tag="5"/>
                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                        </ComboBox>
                        <TextBlock Text="{x:Bind ViewModel.SyncIntervalStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.SyncIntervalStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Appearance -->
            <StackPanel>
                <TextBlock x:Name="AppearanceTitle" Text="Appearance"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <!-- Theme -->
                        <ComboBox x:Name="ThemeBox" Header="Theme"
                                  SelectedIndex="{x:Bind ViewModel.ThemeSelectedIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Content="SystemDefault" Content="System default" Tag="System"/>
                            <ComboBoxItem loc:Loc.Content="Light" Content="Light" Tag="Light"/>
                            <ComboBoxItem loc:Loc.Content="Dark" Content="Dark" Tag="Dark"/>
                        </ComboBox>
                        <TextBlock Text="{x:Bind ViewModel.ThemeStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.ThemeStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Language -->
                        <ComboBox x:Name="LanguageComboBox" Header="Language"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="Follow system" Tag="system"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                        </ComboBox>
                        <TextBlock Text="{x:Bind ViewModel.LanguageStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.LanguageStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Start Minimized -->
                        <ToggleSwitch x:Name="StartMinimizedSwitch" Header="Start minimized"
                                      IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.StartMinimizedStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.StartMinimizedStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Minimize to Tray -->
                        <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="Minimize to system tray"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.MinimizeToTrayStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.MinimizeToTrayStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Security -->
            <StackPanel>
                <TextBlock x:Name="SecurityTitle" Text="Security"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <ToggleSwitch x:Name="AllowSelfSignedSwitch" Header="Allow self-signed SSL certificates"
                                      IsOn="{x:Bind ViewModel.AllowSelfSignedCertificates, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.SelfSignedStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.SelfSignedStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <TextBlock x:Name="SelfSignedHint" Text="Only applies to your configured server host. Required for some self-hosted setups."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Data Management -->
            <StackPanel>
                <TextBlock x:Name="DataTitle" Text="Data"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <Button x:Name="SyncNowButton" Content="Sync Now"
                                Command="{x:Bind ViewModel.ManualSyncCommand}"/>

                        <TextBlock x:Name="SyncNowHint" Text="Rebuild local cache by syncing libraries, progress, and metadata from the server."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"/>

                        <Button x:Name="ClearCacheButton" Content="Clear Local Cache"
                                Command="{x:Bind ViewModel.ClearCacheCommand}"/>

                        <TextBlock x:Name="ClearCacheHint" Text="This will remove cached library data. Downloaded audiobooks will not be affected."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Diagnostics -->
            <StackPanel>
                <TextBlock x:Name="DiagnosticsTitle" Text="Diagnostics"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">

                        <ToggleSwitch x:Name="DiagnosticsModeSwitch" Header="Diagnostics mode"
                                      IsOn="{x:Bind ViewModel.DiagnosticsMode, Mode=TwoWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource RitualSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <TextBlock x:Name="DiagnosticsHint" Text="Enables verbose logging for API requests, state transitions, and playback events."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenLogsButton" Content="Open Logs"
                                    Command="{x:Bind ViewModel.OpenLogFolderCommand}"/>

                            <Button x:Name="ExportLogsButton" Content="Export Logs"
                                    Command="{x:Bind ViewModel.ExportLogsCommand}"/>

                            <Button x:Name="OpenSettingsFolderButton" Content="Open Settings Folder"
                                    Command="{x:Bind ViewModel.OpenSettingsFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Settings Doctor -->
            <StackPanel>
                <TextBlock x:Name="SettingsDoctorTitle" Text="Settings Doctor"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">

                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" loc:Loc.Text="DataFolder" Text="Data folder:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <TextBlock x:Name="SettingsFileLabel" Grid.Row="1" Grid.Column="0" Text="Settings file:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <TextBlock x:Name="SettingsSourceLabel" Grid.Row="2" Grid.Column="0" Text="Settings source:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SettingsSource, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <TextBlock x:Name="TokenSourceLabel" Grid.Row="3" Grid.Column="0" Text="Token source:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.TokenSource, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <TextBlock x:Name="LastLoadedLabel" Grid.Row="4" Grid.Column="0" Text="Last loaded:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.LastLoadedAt, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <TextBlock x:Name="SessionIdLabel" Grid.Row="5" Grid.Column="0" Text="Session ID:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SessionId, Mode=OneWay}"
                                       Style="{StaticResource MonoStyle}"/>

                            <TextBlock x:Name="ServerHostLabel" Grid.Row="6" Grid.Column="0" Text="Server host:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.ServerHost, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>

                            <!-- Shows what is actually persisted, so "did my setting save?" is answerable -->
                            <TextBlock x:Name="PlaybackSavedLabel" Grid.Row="7" Grid.Column="0" Text="Playback saved:" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackFlags, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource StarlightDimBrush}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="DoctorTestConnectionButton" Content="Test Connection"
                                    Command="{x:Bind ViewModel.TestConnectionCommand}"/>

                            <Button x:Name="ResetConnectionButton" Content="Reset Connection"
                                    Command="{x:Bind ViewModel.ResetConnectionCommand}"/>

                            <Button x:Name="OpenDataFolderButton" loc:Loc.Content="OpenDataFolder" Content="Open data folder"
                                    Command="{x:Bind ViewModel.OpenDataFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Nothing to save: every control above persists itself and shows its own
                 confirmation right underneath. Only hard errors (sign-in failed) surface here. -->
            <TextBlock x:Name="AutosaveNote"
                       Text="Changes save automatically — there is no Save button. A ✓ appears under the setting you changed."
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Right"/>

            <InfoBar x:Name="ErrorInfoBar"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"
                     Closed="ErrorInfoBar_Closed"/>

            <!-- About Section -->
            <StackPanel Margin="0,16,0,32">
                <TextBlock x:Name="AboutTitle" Text="About"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,12"/>

                <Border Background="{ThemeResource VoidSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource DustBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Nine Lives Audio"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource StarlightDimBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                   Foreground="{ThemeResource MistBrush}"/>

                        <!-- Update check: reads the newest release of the fork, then hands the
                             user a link instead of replacing the exe behind their back. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="CheckUpdatesButton"
                                    loc:Loc.Content="CheckForUpdates" Content="Check for updates"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"/>
                            <Button x:Name="InstallUpdateButton"
                                    loc:Loc.Content="InstallUpdate" Content="Download and install"
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                    Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"/>
                            <Button x:Name="OpenReleaseButton"
                                    loc:Loc.Content="OpenReleasePage" Content="Download"
                                    Command="{x:Bind ViewModel.OpenReleasePageCommand}"
                                    Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                          Width="16" Height="16"/>
                        </StackPanel>

                        <TextBlock x:Name="UpdateStatusText"
                                   Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasUpdateStatus, Mode=OneWay}"
                                   Foreground="{ThemeResource MistFaintBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <TextBlock loc:Loc.Text="AboutDesc" Text="A lightweight Windows client for Audiobookshelf"
                                   Foreground="{ThemeResource MistFaintBrush}"
                                   TextWrapping="Wrap"/>
                        <Border Margin="0,8,0,0" Padding="0" Background="Transparent">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DisclaimerText" Text="This app is not affiliated with or endorsed by the Audiobookshelf project."
                                           Foreground="{ThemeResource MistFaintBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>
                                <TextBlock x:Name="OpenSourceNoteText" Text="Audiobookshelf is open-source software licensed under GPL-3.0."
                                           Foreground="{ThemeResource MistFaintBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>
                                <HyperlinkButton Content="audiobookshelf.org"
                                                 NavigateUri="https://www.audiobookshelf.org/"
                                                 FontSize="11"
                                                 Padding="0"
                                                 Foreground="{ThemeResource SigilGoldDimBrush}"/>
                                <HyperlinkButton loc:Loc.Content="SourceCode" Content="Source Code on GitHub"
                                                 NavigateUri="https://github.com/one-LN/NineLivesAudio"
                                                 FontSize="11"
                                                 Padding="0"
                                                 Margin="0,4,0,0"
                                                 Foreground="{ThemeResource SigilGoldDimBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
